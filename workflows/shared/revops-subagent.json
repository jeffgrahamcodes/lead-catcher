  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.sales_lead_description }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a RevOps assistant. The user will describe a sales lead in plain text. Your job is to turn that description into a clean, structured record that will be sent straight to Pipedrive to create an organization, a person and a lead.\n\nRules:\n- Only use information that appears in the input. Never invent names, emails, roles or companies.\n- If a field isn't in the input, use \"Unknown\" for name and role, and an empty string for everything else.\n- Write the person's full name in normal capitalization, e.g. \"Jenna Richards\".\n- For company_website, return just the domain, e.g. \"sadowskico.com\", with no \"https://\", \"www.\" or trailing slash.\n- Keep email exactly as given. Do not fix, guess or reformat it.\n- Copy email_source as given, e.g. \"hunter (found)\", \"hunter (inferred)\" or \"website\".\n- In notes, keep the reason this lead is qualified, plus any other useful context from the input, in 1 to 3 sentences.\n- If the input describes more than one lead, only use the first one."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        0
      ],
      "id": "86ffb39b-439b-41d0-a341-05b351a72519",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5.2",
          "mode": "list",
          "cachedResultName": "gpt-5.2"
        },
        "builtInTools": {},
        "options": {
          "reasoningEffort": "low"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        232,
        232
      ],
      "id": "8880f470-1d5b-425b-930d-29954b232a4e",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"name\": \"Full name of the person, e.g. 'Jenna Richards'. Use 'Unknown' if no name was given.\",\n  \"company\": \"Company name, e.g. 'Sadowski & Company'\",\n  \"company_website\": \"Company website domain, e.g. sadowskico.com. Empty string if not given.\",\n  \"role\": \"Their job title. 'Unknown' if not given.\",\n  \"email\": \"Their email address. Empty string if not given. Never invent one.\",\n  \"email_source\": \"Where the email came from, e.g. 'hunter (found)', 'hunter (inferred)', 'website'. Empty string if not given.\",\n  \"notes\": \"Why this is a qualified lead, plus any other useful context from the input\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
